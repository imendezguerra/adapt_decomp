#!/bin/bash
# One stage of the FDSI benchmark, submitted by submit.sh (one array subjob per CHUNK tasks)
#PBS -N fdsi_benchmark
#PBS -j oe
eval "$("$HOME/miniforge3/bin/conda" shell.bash hook)"
conda activate adapt_decomp
set -euo pipefail
cd "$PBS_O_WORKDIR"
python -m benchmarks.fdsi "$STAGE" --chunk "${CHUNK:-1}" ${QUICK:+--quick}
